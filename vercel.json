{
  "buildCommand": "node build/build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/work", "destination": "/work.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/v1", "destination": "/v1/index.html" },
    { "source": "/v1/", "destination": "/v1/index.html" },
    { "source": "/front-door", "destination": "/luke-chat-frontdoor.html" },
    { "source": "/front-door/:path*", "destination": "/luke-chat-frontdoor.html" },
    { "source": "/life", "destination": "/luke-chat-frontdoor.html" },
    { "source": "/life/:path*", "destination": "/luke-chat-frontdoor.html" },
    { "source": "/work/:path*", "destination": "/luke-chat-frontdoor.html" }
  ],
  "functions": {
    "api/chat.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "{content/about/**,src/data/now.json}"
    },
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
