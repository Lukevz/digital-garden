{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/v1",
      "destination": "https://v1.lukevz.com/",
      "permanent": false
    },
    {
      "source": "/v1/:path*",
      "destination": "https://v1.lukevz.com/:path*",
      "permanent": false
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "{content/about/**,src/data/now.json,src/data/brain-index.json}"
    },
    "api/content/list.js": {
      "maxDuration": 10,
      "excludeFiles": "content/photos/collections/**"
    },
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
