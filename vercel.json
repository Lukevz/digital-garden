{
  "buildCommand": "node build/build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/v1", "destination": "/v1/index.html" },
    { "source": "/v1/", "destination": "/v1/index.html" }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "{content/about/**,src/data/now.json,src/data/brain-index.json}"
    },
    "api/content/list.js": {
      "maxDuration": 10,
      "excludeFiles": "content/photos/collections/**"
    },
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
